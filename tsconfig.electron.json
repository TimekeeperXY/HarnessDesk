{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "verbatimModuleSyntax": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": "src",
    "lib": ["ES2023"],
    "types": ["node", "electron"],
    "sourceMap": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.cts", "src/shared/**/*.ts"]
}
